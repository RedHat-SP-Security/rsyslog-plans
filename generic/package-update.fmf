# used in
# https://gitlab.com/redhat/centos-stream/rpms/rsyslog

summary: package update scenario

execute:
    how: tmt

prepare:
  - how: shell
    order: 90
    script:
      # remove installed (tested) rsyslog and any leftovers
      - dnf -y remove '*rsyslog*'
      # install older rsyslog
      - dnf -y install rsyslog --disablerepo test-artifacts

discover:

  - name: Pre_update_scenario
    how: fmf
    url: https://github.com/RedHat-SP-Security/rsyslog-tests
    ref: master
    test:
      - /Sanity/basic-logging-facility/new-syntax
    environment:
      IN_PLACE_UPGRADE: "old"

  - name: Update_rsyslog_package
    how: shell
    tests:
      - name: rsyslog_update
        test: dnf -y update '*rsyslog*'
        duration: 2m

  - name: Post_update_scenario
    how: fmf
    url: https://github.com/RedHat-SP-Security/rsyslog-tests
    ref: master
    test:
      - /Sanity/basic-logging-facility/new-syntax
    environment:
      IN_PLACE_UPGRADE: "new"
